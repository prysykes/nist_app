# NIST AVCAS Environment Configuration
# Copy this file to .env.prod and update with your actual values

# ============================================
# Django Core Settings
# ============================================

# SECURITY WARNING: Generate a strong secret key for production
# You can generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode - MUST be 0 in production
DEBUG=0

# Allowed hosts - comma-separated list of domains/IPs
# Example: DJANGO_ALLOWED_HOSTS=example.com,www.example.com,192.168.1.100
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CSRF Trusted Origins - comma-separated list of URLs
# Example: DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# ============================================
# Database Settings (PostgreSQL)
# ============================================

DATABASE_ENGINE=postgresql
POSTGRES_DB=nist_db
POSTGRES_USER=nist_user
POSTGRES_PASSWORD=change-this-password-in-production
DATABASE_HOST=db
DATABASE_PORT=5432

# ============================================
# Security Settings (Production Only)
# ============================================

# Enable HTTPS redirects (set to 1 when using SSL/TLS)
SECURE_SSL_REDIRECT=0

# Secure cookies (set to 1 when using HTTPS)
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0

# ============================================
# Logging
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=INFO

# ============================================
# Application Settings
# ============================================

# Base ID starting point for video IDs (see settings/config.py)
# BASE_ID_START_POINT=10

# ============================================
# Development Settings (Local Development)
# ============================================
# For local development, create a .env.local file with these settings:
# DEBUG=1
# ALLOWED_HOSTS=*
# SECURE_SSL_REDIRECT=0
# SESSION_COOKIE_SECURE=0
# CSRF_COOKIE_SECURE=0
